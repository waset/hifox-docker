# 首次启动注册节点必填（注册完成后保存在 hifox-config 卷中，后续重启可留空）
INSTALL_TOKEN=

# 镜像地址（可选切换为精简无 GUI 版：ghcr.io/waset/hifox-docker:slim）
HIFOX_IMAGE=ghcr.io/waset/hifox-docker:latest

# 运行时开关官方 CC-Switch Web GUI（true 开启 / false 关闭，关闭后零额外内存占用）
ENABLE_CC_SWITCH=true
CC_SWITCH_PORT=3000
# 公网部署建议设置访问密码（留空则免密访问）
CC_SWITCH_VNC_PASSWORD=

# 可选：容器启动时自动安装到持久化目录的 Agent CLI（逗号分隔，默认留空不安装）
# 支持简称：claude, codex, gemini, codebuddy, agy, opencode（或任意 npm 包名）
AGENT_CLIS=
AGENT_CLIS_UPDATE=false

# 固定容器主机名（请勿随意更改，避免部分依赖主机名加密的 CLI 登录态失效）
HIFOX_HOSTNAME=hifox-daemon
TZ=Asia/Shanghai
