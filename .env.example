# Required on first start only; registration state is persisted in the hifox-config volume.
INSTALL_TOKEN=

# Primary image on Docker Hub (:latest includes Web GUI, :slim is headless).
# Fallback registry if Docker Hub is unreachable: ghcr.io/waset/hifox-docker:latest
HIFOX_IMAGE=waset/hifox-docker:latest

# Toggle the built-in official CC-Switch Web GUI at runtime (true / false).
ENABLE_CC_SWITCH=true
CC_SWITCH_PORT=3000
# Optional VNC password for CC-Switch Web GUI (recommended when exposed beyond localhost).
CC_SWITCH_VNC_PASSWORD=

# Optional comma-separated Agent CLIs to auto-install into persisted /root/.local on startup.
# Supported presets: claude, codex, gemini, codebuddy, agy, opencode (or any npm package name).
AGENT_CLIS=
AGENT_CLIS_UPDATE=false

# Fixed container hostname (do not change after logging in to hostname-salted CLIs).
HIFOX_HOSTNAME=hifox-daemon
TZ=Asia/Shanghai
