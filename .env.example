# 首次启动注册节点必填（注册完成后保存在 hifox-config 卷中，后续重启可留空）
INSTALL_TOKEN=

# 主镜像源为 Docker Hub（:latest 含官方 Web GUI，:slim 为无头精简版）
# 如 Docker Hub 网络不通可切换备用源：ghcr.io/waset/hifox-docker:latest
HIFOX_IMAGE=waset/hifox-docker:latest

# 运行时动态开关官方 CC-Switch Web GUI（true 开启 / false 关闭，关闭后零额外内存占用）
ENABLE_CC_SWITCH=true
CC_SWITCH_PORT=3000
# 可选的 Web GUI 访问密码（公网环境强烈建议设置）
CC_SWITCH_VNC_PASSWORD=

# 可选：容器启动时自动安装至持久化目录 /root/.local 的 Agent CLI（逗号分隔，默认留空不安装）
# 支持简称：claude, codex, gemini, codebuddy, agy, opencode（或任意 npm 包名）
AGENT_CLIS=
AGENT_CLIS_UPDATE=false

# 固定容器主机名（登录 CLI 后请勿随意修改，避免依赖主机名派生的加密 Token 失效）
HIFOX_HOSTNAME=hifox-daemon
TZ=Asia/Shanghai
